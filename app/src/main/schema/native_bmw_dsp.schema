slot 7   0           native   INDEX_LOW_GAIN_R kLowGainR lowGainR
slot 8   -1          native   INDEX_MID_GAIN_L kMidGainL midGainL
slot 9   -1          native   INDEX_MID_GAIN_R kMidGainR midGainR
slot 10  0           native   INDEX_POST_GAIN_L kPostGainL postGainL
slot 11  0           native   INDEX_POST_GAIN_R kPostGainR postGainR

