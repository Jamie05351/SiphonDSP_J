<?xml version="1.0" encoding="utf-8"?>
<!-- Resources the shrinker can't see being used: Preferences.getDefault() looks up
     "default_<key>" by name with getIdentifier(). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@bool/default_*,@integer/default_*,@string/default_*" />
