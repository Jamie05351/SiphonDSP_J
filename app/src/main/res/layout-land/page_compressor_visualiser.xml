<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape variant of page_compressor_visualiser.xml: same visualiser page (graph + master
     strip), just a shorter surface since landscape / head-unit displays have less vertical room.
     Now that the graph is its own pager page rather than a pinned card, it still gets far more
     height than the old ~128dp pinned strip. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/compressor_surface_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            app:cardCornerRadius="18dp">

            <app.siphondsp.view.CompressorSurface
                android:id="@+id/compressor_surface"
                android:layout_width="match_parent"
                android:layout_height="180dp" />
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/compressor_master_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
