<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Band toggle/enable switch are a persistent, non-scrolling header; only the parameter
         sliders below page (see fragment_native_bmw_compressor.xml, portrait, for the full
         explanation; same compressor_slider_pager_container pattern). The visualizer stays in
         its own right-hand pane below, already separate from this scrolling column. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/compressor_split_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Native dual-band dynamics"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/compressor_band_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/compressor_band_low"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="Low" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/compressor_band_mid"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="Mid" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/compressor_enable"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:text="Selected compressor active" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/compressor_slider_pager_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/compressor_split_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/compressor_split_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <app.siphondsp.view.NativeBmwCompressorView
                android:id="@+id/compressor_visualizer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="Interactive selected-band compressor transfer curve"
                app:layout_constraintBottom_toTopOf="@id/compressor_gr_trace"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <app.siphondsp.view.CompressorGrTraceView
                android:id="@+id/compressor_gr_trace"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:contentDescription="Selected-band gain reduction history"
                app:layout_constraintBottom_toTopOf="@id/compressor_meter_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/compressor_meter_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:gravity="center"
                android:padding="6dp"
                android:text="Waiting for native audio…"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
