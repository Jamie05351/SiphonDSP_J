<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/compressor_controls_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="6dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:layout_constraintWidth_percent="0.58"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/compressor_band_toggle"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/compressor_band_low"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:minHeight="0dp"
                        android:text="LOW"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/compressor_band_mid"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:minHeight="0dp"
                        android:text="MID"
                        android:textSize="11sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/compressor_enable"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="12dp"
                    android:checkable="true"
                    android:contentDescription="Selected compressor power"
                    android:minWidth="0dp"
                    app:icon="@drawable/ic_dsp_power_24" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/compressor_threshold_label" android:layout_width="145dp" android:layout_height="wrap_content" android:textColor="#46B5E8" android:textSize="12sp" />
                <com.google.android.material.slider.Slider android:id="@+id/compressor_threshold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/compressor_ratio_label" android:layout_width="145dp" android:layout_height="wrap_content" android:textColor="#46B5E8" android:textSize="12sp" />
                <com.google.android.material.slider.Slider android:id="@+id/compressor_ratio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/compressor_knee_label" android:layout_width="145dp" android:layout_height="wrap_content" android:textColor="#46B5E8" android:textSize="12sp" />
                <com.google.android.material.slider.Slider android:id="@+id/compressor_knee" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/compressor_attack_label" android:layout_width="145dp" android:layout_height="wrap_content" android:textColor="#46B5E8" android:textSize="12sp" />
                <com.google.android.material.slider.Slider android:id="@+id/compressor_attack" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/compressor_release_label" android:layout_width="145dp" android:layout_height="wrap_content" android:textColor="#46B5E8" android:textSize="12sp" />
                <com.google.android.material.slider.Slider android:id="@+id/compressor_release" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/compressor_makeup_label" android:layout_width="145dp" android:layout_height="wrap_content" android:textColor="#46B5E8" android:textSize="12sp" />
                <com.google.android.material.slider.Slider android:id="@+id/compressor_makeup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/compressor_graph_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/compressor_controls_card"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/compressor_graph_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:text="COMPRESSOR CURVE"
                android:textColor="#DDE3E9"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <app.siphondsp.view.NativeBmwCompressorView
                android:id="@+id/compressor_visualizer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="Interactive selected-band compressor transfer curve"
                app:layout_constraintBottom_toTopOf="@id/compressor_gr_trace"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/compressor_graph_title" />

            <app.siphondsp.view.CompressorGrTraceView
                android:id="@+id/compressor_gr_trace"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:contentDescription="Selected-band gain reduction history"
                app:layout_constraintBottom_toTopOf="@id/compressor_meter_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/compressor_meter_text"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="Waiting for native audio…"
                android:textColor="#96A1AB"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>