<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:animateLayoutChanges="true">

    <HorizontalScrollView
        android:id="@+id/horizontalScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbarDefaultDelayBeforeFade="0"
        app:layout_constraintBottom_toTopOf="@id/cards"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/peq_scope_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:selectionRequired="true"
            app:singleSelection="true"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/peq_scope_full"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Input Correction" />

            <com.google.android.material.chip.Chip
                android:id="@+id/peq_scope_low"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Low Band" />

            <com.google.android.material.chip.Chip
                android:id="@+id/peq_scope_mid"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mid Band" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_reset"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peq_reset"
                app:chipIcon="@drawable/ic_twotone_delete_forever_24dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_import_file"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peq_import"
                app:chipIcon="@drawable/ic_twotone_download_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_export_file"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peq_export"
                app:chipIcon="@drawable/ic_twotone_save_24dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_edit_string"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peq_edit_as_string"
                app:chipIcon="@drawable/ic_twotone_edit_24dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_graph_options"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Graph display options"
                android:text="Graph options" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_undo"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Undo last committed PEQ change"
                android:text="Undo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_redo"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Redo last undone PEQ change"
                android:text="Redo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_tools"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Copy and reorder selected filter"
                android:text="Filter tools" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preset_export"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export preset" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preset_import"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Import preset" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_diagnostics"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Review and export a sanitised PEQ diagnostic report"
                android:text="Diagnostics" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_backup_export"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Export complete private PEQ backup"
                android:text="Backup" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_backup_import"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Preview and restore complete private PEQ backup"
                android:text="Restore backup" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/horizontalScrollView">

        <!-- Graph/List mode toggle: pinned to the left edge, always visible. Using a real
             MaterialButtonToggleGroup (like filter_type_group/channel_group below) means the
             "lit" button always matches the checked state, with no separate isEnabled
             bookkeeping that can drift out of sync with peqDisplayMode. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/mode_tab_strip"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/graph_mode_tab"
                style="?attr/materialIconButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:checkable="true"
                android:contentDescription="Show the live graph"
                app:icon="@drawable/ic_baseline_equalizer_24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/list_mode_tab"
                style="?attr/materialIconButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checkable="true"
                android:contentDescription="Show the band list"
                app:icon="@drawable/ic_twotone_nodes_24dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Cross-navigation to the other 3 DSP screens: one-shot navigation actions, kept
             as a separate plain column (not merged into mode_tab_strip's toggle group above)
             since a nav tap isn't a persistent view-mode selection. Stacks directly below the
             Graph/List toggle so both read as one continuous sidebar. -->
        <LinearLayout
            android:id="@+id/peq_cross_nav"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mode_tab_strip" />

        <!-- Only one of edit_card/preview_card is visible at a time (see applyDisplayMode()):
             both span the same full region so List mode is dedicated to the filter list, not
             sharing space with the live visualizer. Inside edit_card, the editor and the list
             are a permanent side-by-side split; see the horizontal LinearLayout below. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/edit_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/mode_tab_strip"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/edit_card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/peq_band_list"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/add_band"
                        style="?attr/materialIconButtonFilledStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/peq_add_band_spaced"
                        android:contentDescription="@string/peq_add_band"
                        app:icon="@drawable/ic_baseline_add_24dp" />

                    <LinearLayout
                        android:id="@+id/band_detail_context_buttons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/cancel"
                            style="?attr/materialIconButtonFilledTonalStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/peq_cancel_spaced"
                            android:contentDescription="@string/peq_cancel"
                            android:tooltipText="@string/peq_cancel"
                            app:icon="@drawable/ic_close_24dp" />

                        <Button
                            android:id="@+id/confirm"
                            style="?attr/materialIconButtonFilledStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/peq_done_spaced"
                            android:contentDescription="@string/peq_done"
                            android:tooltipText="@string/peq_done"
                            app:icon="@drawable/ic_twotone_check_24dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/band_edit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        tools:ignore="SpeakableTextPresentCheck">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="16dp"
                            android:paddingBottom="16dp"
                            android:orientation="vertical">

                            <app.siphondsp.view.NumberInputBox
                                android:id="@+id/freqInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:helperText="@string/peq_frequency_range"
                                app:helperTextEnabled="true"
                                app:hintText="@string/peq_frequency"
                                app:step="10"
                                app:suffixText="Hz"
                                app:value="1000"
                                app:floatPrecision="1"
                                android:min="20"
                                android:max="20000" />

                            <app.siphondsp.view.NumberInputBox
                                android:id="@+id/gainInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:helperText="@string/peq_gain_range"
                                app:helperTextEnabled="true"
                                app:hintText="@string/peq_gain"
                                app:floatPrecision="2"
                                app:step="0.5"
                                app:suffixText="dB"
                                app:value="0"
                                android:min="-30"
                                android:max="30" />

                            <app.siphondsp.view.NumberInputBox
                                android:id="@+id/qInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:helperText="@string/peq_q_range"
                                app:helperTextEnabled="true"
                                app:hintText="@string/peq_q_factor"
                                app:floatPrecision="2"
                                app:step="0.1"
                                app:value="1.41"
                                android:min="0"
                                android:max="30" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="4dp"
                                android:text="@string/peq_filter_type"
                                android:textAppearance="?attr/textAppearanceLabelLarge" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/filter_type_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                app:singleSelection="true"
                                app:selectionRequired="true">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/filter_peaking"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="11sp"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"
                                    android:text="@string/peq_filter_type_peaking" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/filter_low_shelf"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="11sp"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"
                                    android:text="@string/peq_filter_type_low_shelf" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/filter_high_shelf"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="11sp"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"
                                    android:text="@string/peq_filter_type_high_shelf" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/filter_notch"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="11sp"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"
                                    android:text="@string/peq_filter_type_notch" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="4dp"
                                android:text="Channel"
                                android:textAppearance="?attr/textAppearanceLabelLarge" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/channel_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                app:singleSelection="true"
                                app:selectionRequired="true"
                                app:checkedButton="@id/channel_both">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/channel_both"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="11sp"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"
                                    android:text="Both" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/channel_left"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="11sp"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"
                                    android:text="Left" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/channel_right"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="11sp"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"
                                    android:text="Right" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="?android:attr/listDivider" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/empty_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:gravity="center">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:alpha="0.8"
                                android:text="@string/peq_no_bands_defined"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                app:drawableTint="?attr/colorOnBackground"
                                app:drawableTopCompat="@drawable/ic_twotone_nodes_24dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/band_list_header"
                                layout="@layout/item_peq_band_list_header"
                                android:visibility="gone" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/band_list"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:visibility="gone"
                                android:scrollbars="vertical" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/preview_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/mode_tab_strip"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animateLayoutChanges="true">

                <TextView
                    android:id="@+id/preview_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/peq_preview"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <app.siphondsp.view.ParametricEqSurface
                    android:id="@+id/equalizer_surface"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/preview_title" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
