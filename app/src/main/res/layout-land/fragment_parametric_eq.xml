<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:animateLayoutChanges="true">

    <HorizontalScrollView
        android:id="@+id/horizontalScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbarDefaultDelayBeforeFade="0"
        app:layout_constraintBottom_toTopOf="@id/cards"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/peq_scope_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:selectionRequired="true"
            app:singleSelection="true"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/peq_scope_full"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Input Correction" />

            <com.google.android.material.chip.Chip
                android:id="@+id/peq_scope_low"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Low Band" />

            <com.google.android.material.chip.Chip
                android:id="@+id/peq_scope_mid"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mid Band" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_reset"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peq_reset"
                app:chipIcon="@drawable/ic_twotone_delete_forever_24dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_import_file"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peq_import"
                app:chipIcon="@drawable/ic_twotone_download_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_export_file"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peq_export"
                app:chipIcon="@drawable/ic_twotone_save_24dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_edit_string"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peq_edit_as_string"
                app:chipIcon="@drawable/ic_twotone_edit_24dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_graph_options"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Graph display options"
                android:text="Graph options" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_undo"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Undo last committed PEQ change"
                android:text="Undo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_redo"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Redo last undone PEQ change"
                android:text="Redo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_tools"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Copy and reorder selected filter"
                android:text="Filter tools" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preset_export"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export preset" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preset_import"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Import preset" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_diagnostics"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Review and export a sanitised PEQ diagnostic report"
                android:text="Diagnostics" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_backup_export"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Export complete private PEQ backup"
                android:text="Backup" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_backup_import"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Preview and restore complete private PEQ backup"
                android:text="Restore backup" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/horizontalScrollView">

        <!-- Graph and List are swipeable pages of a ViewPager2 (position 0 = preview_card/GRAPH,
             1 = edit_card/LIST); see configurePager()/applyDisplayMode() in the fragment.
             edit_card/preview_card stay declared below (still needed for ViewBinding to generate
             their field references and for portrait, which doesn't use cards_pager) but are
             detached from this ConstraintLayout and handed to cards_pager's adapter at
             view-creation time. Cross-navigation to the other 3 DSP screens used to live here
             (peq_cross_nav) but now lives in the activity's full-height sidebar instead; see
             activity_parametric_eq.xml and ParametricEqualizerActivity. This spans the whole
             width now that peq_cross_nav is gone. -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/cards_pager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Inside edit_card, the editor and the list are a permanent side-by-side split; see
             the horizontal LinearLayout below. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/edit_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/edit_card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/peq_band_list"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                </LinearLayout>

                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider" />

                <include
                    android:id="@+id/band_list_header"
                    layout="@layout/item_peq_band_list_header" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/band_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/preview_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animateLayoutChanges="true">

                <TextView
                    android:id="@+id/preview_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/peq_preview"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <app.siphondsp.view.ParametricEqSurface
                    android:id="@+id/equalizer_surface"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/preview_title" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
