<?xml version="1.0" encoding="utf-8"?>
<!-- Darkened, embossed value/title box shared by every DSP workspace slider row; see
     Widget.SiphonDSP.SliderValueBox / Widget.SiphonDSP.SliderTitleBox and
     BmwDashboardSkin.sliderBoxDrawable() (the same look, drawn programmatically, for
     CrossoverDashboardBuilder's own slider rows). Highlight/shadow lines use gravity+size, not
     fixed top/bottom insets, so they stay a true 1dp regardless of the box's actual rendered
     height (which isn't locked to one exact value here). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bmw_dsp_value_box_background" />
            <corners android:radius="5dp" />
            <stroke android:width="1dp" android:color="@color/bmw_dsp_accent_blue" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#343A40" />
            <size android:height="1dp" />
        </shape>
    </item>
    <item android:left="1dp" android:bottom="1dp" android:right="1dp" android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="#80000000" />
            <size android:height="1dp" />
        </shape>
    </item>
</layer-list>
