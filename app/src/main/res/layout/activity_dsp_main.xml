<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".activity.MainActivity">

    <!-- The front page's own header is now baked into dsp_home_backdrop.png (see content_main.xml).
         This toolbar is kept in the tree (MainActivity.kt calls setSupportActionBar() /
         actionBar?.set*() on it, and LibraryLoadErrorFragment's error state still toggles its
         visibility) but never shown here, rather than removing it and hunting every reference. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:colorBackground"
        android:fitsSystemWindows="true"
        android:visibility="gone"
        app:liftOnScroll="true"
        app:liftOnScrollColor="?attr/colorPrimaryContainer"
        app:liftOnScrollTargetViewId="@id/dsp_scrollview"
        app:statusBarForeground="@android:color/transparent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Theme.SiphonDSP.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_toolbar_height"
            android:background="@android:color/transparent"
            app:titleCentered="true" />

        <include layout="@layout/view_m_stripe_divider" />

    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/content_main" />

    <!-- Touch overlay for the front page's power button, LED, settings cog and overflow menu,
         laid over the artwork by the same HomeArtLayout mapping as the page beneath it. It
         replaces the old bottom bar and power FAB. MainActivity hides it while the pager is on
         its second (settings) page. Empty areas pass touches through to the pager. -->
    <app.siphondsp.view.HomeArtLayout
        android:id="@+id/home_chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <app.siphondsp.view.PowerHotspot
            android:id="@+id/power_toggle"
            android:tag="power_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hapticFeedbackEnabled="true"
            android:contentDescription="@string/power_button_alt" />

        <app.siphondsp.view.PowerLed
            android:id="@+id/power_led"
            android:tag="power_led"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/action_settings"
            android:tag="cog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_twotone_settings_24dp"
            app:tint="#B8C4D0"
            android:contentDescription="@string/title_activity_settings" />

        <ImageView
            android:id="@+id/action_overflow"
            android:tag="overflow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_more_vert_24dp"
            app:tint="#B8C4D0"
            android:contentDescription="@string/abc_action_menu_overflow_description" />
    </app.siphondsp.view.HomeArtLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
