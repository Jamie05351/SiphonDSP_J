<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page_shortcuts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.DspFragment"
    tools:ignore="SpeakableTextPresentCheck">

    <!-- Front page: one full-bleed hardware-panel image (dsp_home_backdrop.jpg, 2340x878, drawn
         for the 1280x480 head unit) with no margins, padding, header or bottom bar around it.
         Everything live is laid over the artwork's own regions by HomeArtLayout, which places each
         child by its tag (see HomeArt.kt) using the same centerCrop mapping as this ImageView:
         the 7 menu tiles (each its own image and touch area), the live status strip above them, and the
         three top displays - left crossover response, centre PEQ curve (both read-only) and
         right L/R level bars. The power button remains in the activity overlay. Must never scroll. -->
    <ImageView
        android:id="@+id/home_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/dsp_home_backdrop"
        android:importantForAccessibility="no" />

    <app.siphondsp.view.HomeArtLayout
        android:id="@+id/dsp_destination_cards"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/card_shortcut_peq"
            android:tag="tile_peq"
            android:src="@drawable/home_tile_peq"
            android:scaleType="fitXY"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/action_parametric_eq" />

        <ImageView
            android:id="@+id/card_shortcut_gains_delay"
            android:tag="tile_gains"
            android:src="@drawable/home_tile_gains"
            android:scaleType="fitXY"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/action_gain_limiter" />

        <ImageView
            android:id="@+id/card_shortcut_crossovers"
            android:tag="tile_xovers"
            android:src="@drawable/home_tile_xovers"
            android:scaleType="fitXY"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/action_crossover_tilt" />

        <ImageView
            android:id="@+id/card_shortcut_compressor"
            android:tag="tile_compressor"
            android:src="@drawable/home_tile_compressor"
            android:scaleType="fitXY"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/action_compressor" />

        <ImageView
            android:id="@+id/card_shortcut_allpass"
            android:tag="tile_allpass"
            android:src="@drawable/home_tile_allpass"
            android:scaleType="fitXY"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/action_allpass" />

        <ImageView
            android:id="@+id/card_shortcut_settings"
            android:tag="tile_settings"
            android:src="@drawable/home_tile_settings"
            android:scaleType="fitXY"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/title_activity_settings" />

        <ImageView
            android:id="@+id/card_shortcut_more"
            android:tag="tile_more"
            android:src="@drawable/home_tile_more"
            android:scaleType="fitXY"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/abc_action_menu_overflow_description" />

        <app.siphondsp.view.HomeDashboardStatusView
            android:id="@+id/home_dashboard_status"
            android:tag="live_strip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <app.siphondsp.view.NoTouchFrameLayout
            android:tag="box_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/home_crossover_graph"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </app.siphondsp.view.NoTouchFrameLayout>

        <app.siphondsp.view.NoTouchFrameLayout
            android:tag="box_centre"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/home_peq_graph"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </app.siphondsp.view.NoTouchFrameLayout>

        <app.siphondsp.view.HomeLevelBars
            android:id="@+id/home_level_bars"
            android:tag="box_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:importantForAccessibility="no" />
    </app.siphondsp.view.HomeArtLayout>

    <!-- Notices float over the top of the artwork instead of pushing it down. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical">

        <app.siphondsp.view.Card
            android:id="@+id/translation_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            app:bodyText="@string/translation_notice_summary"
            app:titleText="@string/translation_notice"
            app:cardBackground="?attr/colorSurfaceVariant"
            app:cardMargin="0dp"
            app:closeButtonVisible="true"
            app:iconSrc="@drawable/ic_twotone_translate_24dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <app.siphondsp.view.Card
            android:id="@+id/update_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            app:bodyText="@string/self_update_notice_summary"
            app:titleText="@string/self_update_notice"
            app:cardBackground="?attr/colorSurfaceVariant"
            app:cardMargin="0dp"
            app:closeButtonVisible="true"
            app:iconSrc="@drawable/ic_baseline_download_24dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</FrameLayout>
