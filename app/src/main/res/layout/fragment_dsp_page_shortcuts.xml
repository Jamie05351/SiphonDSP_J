<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page_shortcuts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.DspFragment"
    tools:ignore="SpeakableTextPresentCheck">

    <!-- Front page: one full-bleed hardware faceplate, drawn live by HomeFaceplate (Compose) with no
         margins, padding, header or bottom bar around it. Everything live is laid over the faceplate's
         own regions by HomeArtLayout, which places each child by its tag (see HomeArt.kt) using the
         same fit mapping as the faceplate: the 7 menu tiles (each a Compose tile in a clickable
         ComposeView, so a tile's picture and its touch area are the same box) and the live panel's
         three blocks (output levels, audio engine, global stages). The power button remains in the
         activity overlay (PowerHotspot draws it). Must never scroll. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/home_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <app.siphondsp.view.HomeArtLayout
        android:id="@+id/dsp_destination_cards"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/card_shortcut_peq"
            android:tag="tile_peq"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/action_parametric_eq" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/card_shortcut_gains_delay"
            android:tag="tile_gains"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/action_gain_limiter" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/card_shortcut_crossovers"
            android:tag="tile_xovers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/action_crossover_tilt" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/card_shortcut_compressor"
            android:tag="tile_compressor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/action_compressor" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/card_shortcut_allpass"
            android:tag="tile_allpass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/action_allpass" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/card_shortcut_settings"
            android:tag="tile_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/title_activity_settings" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/card_shortcut_more"
            android:tag="tile_more"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/abc_action_menu_overflow_description" />

        <app.siphondsp.view.HomeLevelBars
            android:id="@+id/home_level_bars"
            android:tag="live_output"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <app.siphondsp.view.HomeEngineStatusView
            android:id="@+id/home_engine_status"
            android:tag="live_engine"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- Each stage cell opens the screen that owns it, as on the workspace toolbar. -->
        <app.siphondsp.view.DspStatusStrip
            android:id="@+id/home_stages"
            android:tag="live_stages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:stacked="true" />
    </app.siphondsp.view.HomeArtLayout>

    <!-- Notices float over the top of the artwork instead of pushing it down. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical">

        <app.siphondsp.view.Card
            android:id="@+id/translation_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            app:bodyText="@string/translation_notice_summary"
            app:titleText="@string/translation_notice"
            app:cardBackground="?attr/colorSurfaceVariant"
            app:cardMargin="0dp"
            app:closeButtonVisible="true"
            app:iconSrc="@drawable/ic_twotone_translate_24dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <app.siphondsp.view.Card
            android:id="@+id/update_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            app:bodyText="@string/self_update_notice_summary"
            app:titleText="@string/self_update_notice"
            app:cardBackground="?attr/colorSurfaceVariant"
            app:cardMargin="0dp"
            app:closeButtonVisible="true"
            app:iconSrc="@drawable/ic_baseline_download_24dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</FrameLayout>
