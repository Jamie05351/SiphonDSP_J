<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page_shortcuts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.DspFragment"
    tools:ignore="SpeakableTextPresentCheck">

    <!-- Front page: one Compose screen (HomeScreen) filling the page, with no margins, padding,
         header or bottom bar around it: the global stages, the output meter, More and Settings,
         and the signal chain from the power button through the five DSP tiles to OUT. Must never
         scroll. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/home_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The More menu's anchor: moved onto the More button before the menu opens. -->
    <View
        android:id="@+id/home_more_anchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:importantForAccessibility="no" />

    <!-- Notices float over the top of the artwork instead of pushing it down. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical">

        <app.siphondsp.view.Card
            android:id="@+id/translation_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            app:bodyText="@string/translation_notice_summary"
            app:titleText="@string/translation_notice"
            app:cardBackground="?attr/colorSurfaceVariant"
            app:cardMargin="0dp"
            app:closeButtonVisible="true"
            app:iconSrc="@drawable/ic_twotone_translate_24dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <app.siphondsp.view.Card
            android:id="@+id/update_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            app:bodyText="@string/self_update_notice_summary"
            app:titleText="@string/self_update_notice"
            app:cardBackground="?attr/colorSurfaceVariant"
            app:cardMargin="0dp"
            app:closeButtonVisible="true"
            app:iconSrc="@drawable/ic_baseline_download_24dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</FrameLayout>
