<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/native_bmw_signal_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/native_bmw_response_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingBottom="8dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@+id/native_bmw_response_mode_magnitude">

        <Button
            android:id="@+id/native_bmw_response_mode_magnitude"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="Mag" />

        <Button
            android:id="@+id/native_bmw_response_mode_phase"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="Phase" />

        <Button
            android:id="@+id/native_bmw_response_mode_both"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="Mag+Phase" />

        <Button
            android:id="@+id/native_bmw_response_mode_group_delay"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="Group Delay" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <app.siphondsp.fragment.NativeBmwDspResponseView
        android:id="@+id/native_bmw_response_view"
        android:layout_width="match_parent"
        android:layout_height="220dp" />
</LinearLayout>
