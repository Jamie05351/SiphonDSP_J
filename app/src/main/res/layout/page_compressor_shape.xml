<?xml version="1.0" encoding="utf-8"?>
<!-- One page of NativeBmwCompressorFragment's slider pager: the "shape" params (Threshold,
     Ratio, Knee). Visualizer/band-toggle/enable switch stay in the persistent header above the
     pager in fragment_native_bmw_compressor.xml; only the parameter sliders are paged. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="4dp"
        android:paddingBottom="18dp">

        <!-- Each slider is one row: title, a flexible gap, the value in a darkened box
             (Widget.SiphonDSP.SliderValueBox) sitting at the end of a fixed-width label column,
             then the slider filling the rest; same layout/typography as
             CrossoverDashboardBuilder.addSliderRow() on the other DSP workspaces. Value text is
             set at runtime in NativeBmwCompressorFragment. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="150dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/compressor_threshold_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Threshold" android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/compressor_threshold_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/compressor_threshold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="150dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/compressor_ratio_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ratio" android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/compressor_ratio_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/compressor_ratio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="24dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="150dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/compressor_knee_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Soft knee" android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/compressor_knee_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/compressor_knee" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
