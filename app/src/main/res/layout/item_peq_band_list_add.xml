<?xml version="1.0" encoding="utf-8"?>
<!-- Trailing row shown only while the current scope has fewer than
     BmwPeqState.MAX_BANDS filters (see ParametricEqBandAdapter.getItemCount/getItemViewType).
     Tapping it adds a new default band and this row shifts down to sit after it; once the
     scope hits the cap, the adapter simply stops emitting this item and the list ends on the
     last real band row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/add_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?android:attr/listPreferredItemHeightSmall"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/add_row_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:minHeight="30dp"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:drawablePadding="8dp"
        app:drawableStartCompat="@drawable/ic_baseline_add_24dp"
        android:text="@string/peq_add_filter_row" />

</LinearLayout>
