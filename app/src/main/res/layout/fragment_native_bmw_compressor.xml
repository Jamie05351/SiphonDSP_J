<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Native dual-band dynamics"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Choose the low or mid branch, then adjust its independent stereo-linked compressor."
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/compressor_band_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compressor_band_low"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Low band" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compressor_band_mid"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Mid band" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <app.siphondsp.view.NativeBmwCompressorView
                    android:id="@+id/compressor_visualizer"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:contentDescription="Interactive compressor transfer curve and live gain reduction" />

                <app.siphondsp.view.CompressorGrTraceView
                    android:id="@+id/compressor_gr_trace"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:contentDescription="Scrolling input level and gain reduction history" />

                <TextView
                    android:id="@+id/compressor_meter_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="Waiting for native audio…"
                    android:textAlignment="center"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/compressor_enable"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:text="Selected compressor active" />

        <!-- Each slider is one row: title, a flexible gap, the value in a darkened box
             (Widget.SiphonDSP.SliderValueBox) sitting at the end of a fixed-width label column,
             then the slider filling the rest; same layout/typography as
             CrossoverDashboardBuilder.addSliderRow() on the other DSP workspaces. Value text is
             set at runtime in NativeBmwCompressorFragment. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="150dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/compressor_threshold_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Threshold" android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/compressor_threshold_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/compressor_threshold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="150dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/compressor_ratio_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ratio" android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/compressor_ratio_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/compressor_ratio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="150dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/compressor_knee_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Soft knee" android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/compressor_knee_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/compressor_knee" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="150dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/compressor_attack_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Attack" android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/compressor_attack_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/compressor_attack" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="150dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/compressor_release_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Release" android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/compressor_release_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/compressor_release" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="24dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="150dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/compressor_makeup_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Makeup gain" android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/compressor_makeup_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.slider.Slider android:id="@+id/compressor_makeup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
