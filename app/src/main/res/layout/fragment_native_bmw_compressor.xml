<?xml version="1.0" encoding="utf-8"?>
<!-- The pre-crossover multiband-compressor screen is now a single full-bleed DspPager.
     Page 1 is the CompressorSurface visualiser plus the MBC master strip (see
     page_compressor_visualiser.xml), pages 2 to 5 are the four band pages, and page 6 is the
     Driver-protection page. All pages are built in NativeBmwCompressorFragment. The visualiser
     used to be a pinned card here, but on a short head-unit display that left the band pages
     almost no room, so it became the first page instead and every page now gets the full
     content area. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compressor_slider_pager_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
