<?xml version="1.0" encoding="utf-8"?>
<!-- Each band's complete view (title, enable switch, visualizer, GR trace, meter, and all 6
     parameter sliders) lives on its own page (page_compressor_band.xml), inflated twice by
     NativeBmwCompressorFragment and paged via DspPager. Swiping moves the whole band view at
     once, so there's a large non-slider touch area (the visualizer) to start the swipe from. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compressor_slider_pager_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
