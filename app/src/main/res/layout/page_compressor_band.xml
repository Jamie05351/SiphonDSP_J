<?xml version="1.0" encoding="utf-8"?>
<!-- One band's complete view: title/enable switch, its own visualizer + GR trace + meter
     readout, and its own 6 parameter sliders. NativeBmwCompressorFragment inflates this twice,
     once per band, and swipes the whole page (not just the sliders) via DspPager. The
     visualizer gives a large non-slider touch area to start the swipe gesture from, so swiping
     doesn't accidentally drag a slider. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/compressor_band_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Low Band Dynamics"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/compressor_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Compressor active" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/compressor_visualizer_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Shrunk from 260dp/100dp: this card sees little real use day-to-day, so it
                     gives up height to the 6 sliders below it instead of crowding them. -->
                <app.siphondsp.view.NativeBmwCompressorView
                    android:id="@+id/compressor_visualizer"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:contentDescription="Interactive compressor transfer curve and live gain reduction" />

                <app.siphondsp.view.CompressorGrTraceView
                    android:id="@+id/compressor_gr_trace"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:contentDescription="Scrolling input level and gain reduction history" />

                <TextView
                    android:id="@+id/compressor_meter_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Waiting for native audio…"
                    android:textAlignment="center"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Each slider is one row: title (fixed-width column), then the slider filling the rest,
             then the value in a darkened box (Widget.SiphonDSP.SliderValueBox) at the very end:
             the same title/slider/value-box order and sizing as
             CrossoverDashboardBuilder.addSliderRow (the Crossovers & Tilt/Gains & Delay/Routing
             sliders), so every DSP workspace slider looks and reads the same way. Value text is
             set at runtime in NativeBmwCompressorFragment; the box is also tap-to-edit there. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/compressor_threshold_title" android:layout_width="225dp" android:layout_height="wrap_content" android:text="Threshold" android:textSize="13sp" android:textColor="#E7EBEF" android:maxLines="1" android:ellipsize="end" />
            <com.google.android.material.slider.Slider android:id="@+id/compressor_threshold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" />
            <TextView android:id="@+id/compressor_threshold_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/compressor_ratio_title" android:layout_width="225dp" android:layout_height="wrap_content" android:text="Ratio" android:textSize="13sp" android:textColor="#E7EBEF" android:maxLines="1" android:ellipsize="end" />
            <com.google.android.material.slider.Slider android:id="@+id/compressor_ratio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" />
            <TextView android:id="@+id/compressor_ratio_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/compressor_knee_title" android:layout_width="225dp" android:layout_height="wrap_content" android:text="Soft knee" android:textSize="13sp" android:textColor="#E7EBEF" android:maxLines="1" android:ellipsize="end" />
            <com.google.android.material.slider.Slider android:id="@+id/compressor_knee" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" />
            <TextView android:id="@+id/compressor_knee_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/compressor_attack_title" android:layout_width="225dp" android:layout_height="wrap_content" android:text="Attack" android:textSize="13sp" android:textColor="#E7EBEF" android:maxLines="1" android:ellipsize="end" />
            <com.google.android.material.slider.Slider android:id="@+id/compressor_attack" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" />
            <TextView android:id="@+id/compressor_attack_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/compressor_release_title" android:layout_width="225dp" android:layout_height="wrap_content" android:text="Release" android:textSize="13sp" android:textColor="#E7EBEF" android:maxLines="1" android:ellipsize="end" />
            <com.google.android.material.slider.Slider android:id="@+id/compressor_release" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" />
            <TextView android:id="@+id/compressor_release_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/compressor_makeup_title" android:layout_width="225dp" android:layout_height="wrap_content" android:text="Makeup gain" android:textSize="13sp" android:textColor="#E7EBEF" android:maxLines="1" android:ellipsize="end" />
            <com.google.android.material.slider.Slider android:id="@+id/compressor_makeup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" />
            <TextView android:id="@+id/compressor_makeup_value" style="@style/Widget.SiphonDSP.SliderValueBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
