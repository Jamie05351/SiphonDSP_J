<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".activity.ParametricEqualizerActivity">

    <!-- Full-screen workspace backdrop: per-destination art (rail housing, tile buttons, lit
         selection glow, background field and the ///M carbon logo all baked in together) &#8212; see
         DspDestination.backdrop. DspCrossNavBar.populate() swaps this image per destination.
         Authored at 1280x480 mdpi, edge to edge (the head unit runs with no system bars), so it
         fills the whole activity behind every other layer. -->
    <ImageView
        android:id="@+id/dsp_workspace_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:src="@drawable/dsp_workspace_backdrop_peq"
        tools:src="@drawable/dsp_workspace_backdrop_peq" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dsp_workspace_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Full-height column for the rail: the panel/tiles/icons/selection glow are baked into
             the per-destination backdrop image (R.id.dsp_workspace_backdrop) behind this column,
             and dsp_cross_nav overlays it with the invisible click-target / focus-ring rows that
             DspCrossNavBar.populate() lays over each tile's measured bounds. Fixed width &#8212; the
             rail is a fixed pixel fixture; see @dimen/dsp_sidebar_width. -->
        <FrameLayout
            android:id="@+id/dsp_sidebar"
            android:layout_width="@dimen/dsp_sidebar_width"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/dsp_cross_nav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone" />
        </FrameLayout>

        <!-- The fragment content sits to the right of the rail and starts below the floating
             transparent toolbar line (header_toolbar_height); the backdrop still shows through
             the top strip behind that toolbar. -->
        <FrameLayout
            android:id="@+id/params"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/header_toolbar_height"
            app:layout_constraintStart_toEndOf="@id/dsp_sidebar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Declared last so the toolbar chrome renders above the content. Transparent, no elevation,
         no ///M stripe (removed &#8212; the carbon ///M logo is baked into the backdrop's bottom-right
         instead). The back arrow and bypass-state strip are indented past the rail so they never
         sit over it. -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Theme.SiphonDSP.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/header_toolbar_height"
                android:background="@android:color/transparent"
                android:paddingStart="@dimen/dsp_sidebar_width"
                android:paddingEnd="24dp"
                app:contentInsetStart="@dimen/dsp_sidebar_width"
                app:contentInsetStartWithNavigation="@dimen/dsp_sidebar_width"
                app:contentInsetEnd="24dp"
                app:contentInsetEndWithActions="24dp" />

            <app.siphondsp.view.DspStatusStrip
                android:id="@+id/dsp_status_strip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/dsp_status_strip_margin_start" />
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
