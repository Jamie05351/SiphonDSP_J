<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".activity.ParametricEqualizerActivity">

    <!-- Full-screen workspace faceplate (textured background + slim metal screen bezel), drawn live by
         DspWorkspaceBackdrop (Compose): DspCrossNavBar.populate() sets its content. The rail housing
         and tiles are drawn by dsp_cross_nav below, not by this view. Authored for 1280x480 mdpi, edge
         to edge (the head unit runs with no system bars), so it fills the whole activity behind every
         other layer. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/dsp_workspace_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dsp_workspace_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Full-height column for the rail: dsp_cross_nav draws the rail housing and the 5 tiles live
             (DspSidebarRail, Compose) and hosts their touch targets; the current destination's tile
             is lit and inert. Fixed width, since the rail is a fixed fixture; see
             @dimen/dsp_sidebar_width. -->
        <FrameLayout
            android:id="@+id/dsp_sidebar"
            android:layout_width="@dimen/dsp_sidebar_width"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/dsp_cross_nav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <!-- The fragment content sits to the right of the rail and starts below the floating
             transparent toolbar line (dsp_workspace_toolbar_height); the faceplate still shows
             through the top strip behind that toolbar. It stops short of the faceplate's bezel on
             the right and bottom (dsp_workspace_bezel_inset). -->
        <FrameLayout
            android:id="@+id/params"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dsp_workspace_toolbar_height"
            android:layout_marginEnd="@dimen/dsp_workspace_bezel_inset"
            android:layout_marginBottom="@dimen/dsp_workspace_bezel_inset"
            app:layout_constraintStart_toEndOf="@id/dsp_sidebar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Declared last so the toolbar chrome renders above the content. Transparent, no elevation,
         no ///M stripe. The back arrow and bypass-state strip are indented past the rail so they never
         sit over it. -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Starts at the rail's edge (layout_marginStart), not at x=0 with a big paddingStart:
                 a Toolbar swallows every touch inside its bounds, so a full-width one covered the
                 top of the rail and made the first tile (PEQ) dead over its upper part. The back
                 arrow still lands at the same x: rail + dsp_toolbar_nav_inset. -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Theme.SiphonDSP.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dsp_workspace_toolbar_height"
                android:background="@android:color/transparent"
                android:paddingTop="25dp"
                android:layout_marginStart="@dimen/dsp_sidebar_width"
                android:paddingStart="@dimen/dsp_toolbar_nav_inset"
                android:paddingEnd="24dp"
                app:contentInsetStart="@dimen/dsp_toolbar_nav_inset"
                app:contentInsetStartWithNavigation="@dimen/dsp_toolbar_nav_inset"
                app:contentInsetEnd="24dp"
                app:contentInsetEndWithActions="24dp" />

            <app.siphondsp.view.DspStatusStrip
                android:id="@+id/dsp_status_strip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/dsp_status_strip_margin_start" />

            <!-- Shared toolbar-action slot: gone/zero-effect until an activity finds this id and
                 sets its content. ParametricEqualizerActivity uses it for the Pre EQ/Low/Mid scope
                 switch + action-chip row (hides dsp_status_strip alongside it, since there's no
                 room for both on one line once that row is showing: see PeqToolbarActions).
                 GainLimiterActivity/CrossoverTiltActivity/NativeBmwCompressorActivity use it for
                 DspPagerArrows (prev/next page buttons, sitting to the right of dsp_status_strip,
                 which they leave visible).

                 layout_marginStart is PEQ's own leading dsp_toolbar_nav_inset gap, kept as the
                 default since it's harmless (just empty space) for a non-scrolling arrows-only
                 content: a full-width ComposeView only hit-tests where it actually draws an
                 interactive composable, unlike PEQ's horizontalScroll Row, which installs a drag
                 detector spanning its whole viewport and previously ate touches meant for the
                 toolbar's back arrow underneath (that bug was fixed by moving PEQ's own inset here
                 rather than as Compose-side padding; DspPagerArrows has no such scrollable
                 container, so it isn't at risk of repeating it). -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/dsp_toolbar_actions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dsp_status_strip_margin_start"
                android:visibility="gone" />
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
