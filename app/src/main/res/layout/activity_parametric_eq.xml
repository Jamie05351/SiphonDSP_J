<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".activity.ParametricEqualizerActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="false">

        <!-- The toggle slot below is a sibling overlay on top of the toolbar, not a row after
             it, so it shares the toolbar's own 36dp height instead of adding one: the header's
             total height (toolbar + stripe) is unchanged from before DspPager routed here. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Theme.SiphonDSP.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/header_toolbar_height"
                android:background="@color/dsp_workspace_header_bg"
                android:paddingEnd="24dp"
                app:contentInsetEnd="24dp"
                app:contentInsetEndWithActions="24dp"
                app:titleCentered="true" />

            <!-- DspPager's numbered page toggle (Gains & Delay, Crossovers & Tilt, Compressor,
                 All-pass) docks here when a fragment provides it, floating over the toolbar just
                 left of its power icon, above the tri-colour stripe below. Empty/gone on
                 screens that don't page (e.g. the Parametric EQ screen, which builds its own
                 pager). -->
            <FrameLayout
                android:id="@+id/dsp_page_toggle_slot"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="64dp" />
        </FrameLayout>

        <include layout="@layout/view_m_stripe_divider" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dsp_workspace_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Sidebar for the content area only, below the toolbar; not alongside it. Holds
             dsp_cross_nav (destination icons, including Routing, populated by
             DspCrossNavBar.populate()). Settings/overflow used to also live here but were
             removed in favor of MainActivity's bottom bar being the sole entry point for those;
             see DspWorkspaceActivity.setUpWorkspaceSidebarActions() for the panel background.
             Back navigation and the power toggle stay in the toolbar itself. -->
        <!-- Flush against all three edges (top, bottom, left) of the content area, so the panel
             reads as a structural fixture built into the workspace.
             Width is not a fixed dp. The panel itself is no longer drawn here; it's baked into
             the dsp_workspace_content backdrop (drawable-mdpi/dsp_workspace_backdrop_*.png, one
             per DspDestination, painted by DspCrossNavBar.populate()) alongside the content-pane
             texture, at native 1:1 scale against the content area's own bounds. This column exists
             purely to reserve that same width for dsp_cross_nav's invisible click-target/focus-ring
             rows, which must land exactly on the backdrop's baked-in tiles. The 714:3258 ratio is
             the original bar-art panel's own measured proportions, which the new backdrop's panel
             still matches (measured ~91dp wide at this column's 417dp content-area height, against
             714/3258 x 417 = 91.39dp), close enough that the ratio didn't need to change when the
             art did. No marginStart, no padding, no constraintWidth_max. -->
        <LinearLayout
            android:id="@+id/dsp_sidebar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintDimensionRatio="714:3258"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/dsp_cross_nav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Anchors the sidebar to the content area it controls: without it the tile column
             reads as a separate panel floating over the shared background rather than a fixture
             built into the workspace, since neither side has its own opaque fill to imply a seam. -->
        <View
            android:id="@+id/dsp_sidebar_divider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="#3E4854"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/dsp_sidebar" />

        <FrameLayout
            android:id="@+id/params"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toEndOf="@id/dsp_sidebar_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
