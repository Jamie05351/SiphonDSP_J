<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".activity.ParametricEqualizerActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Theme.SiphonDSP.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_toolbar_height"
            android:paddingEnd="24dp"
            app:contentInsetEnd="24dp"
            app:contentInsetEndWithActions="24dp"
            app:titleCentered="true" />

        <include layout="@layout/view_m_stripe_divider" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Sidebar for the content area only, below the toolbar; not alongside it. Holds
             dsp_cross_nav (destination icons, including Routing, populated by
             DspCrossNavBar.populate()). Settings/overflow used to also live here but were
             removed in favor of MainActivity's bottom bar being the sole entry point for those;
             see DspWorkspaceActivity.setUpWorkspaceSidebarActions() for the panel background.
             Back navigation and the power toggle stay in the toolbar itself. -->
        <!-- Flush against the top and bottom edges of the content area (no margins), so the
             panel reads as a structural fixture built into the workspace.
             Width is not a fixed dp. The bar art (drawable-nodpi/sidebar_bar_*.png) is a fixed
             643x2982 canvas shown FIT_CENTER, and in landscape it is always height-constrained,
             so its rendered width is exactly (column height * 643 / 2982). Pinning the column to
             that same ratio makes it exactly as wide as the art, with no centering slack on
             either side, so the art sits hard against the (6dp-inset) left edge and the divider
             plus content pane butt straight up against the art instead of a 120dp box. The art
             itself is not resized; only the dead padding around it is removed. constraintWidth_max
             keeps the column sane on an unexpectedly tall/portrait viewport where the art would
             instead be width-constrained. -->
        <LinearLayout
            android:id="@+id/dsp_sidebar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            app:layout_constraintDimensionRatio="643:2982"
            app:layout_constraintWidth_max="120dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/dsp_cross_nav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Anchors the sidebar to the content area it controls: without it the tile column
             reads as a separate panel floating over the shared background rather than a fixture
             built into the workspace, since neither side has its own opaque fill to imply a seam. -->
        <View
            android:id="@+id/dsp_sidebar_divider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="#3E4854"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/dsp_sidebar" />

        <FrameLayout
            android:id="@+id/params"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toEndOf="@id/dsp_sidebar_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
