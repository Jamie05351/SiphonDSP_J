<?xml version="1.0" encoding="utf-8"?>
<!-- BMW ///M Motorsport tri-color stripe, used as the dividing line under the top banner on
     every screen. Three equal-width bands via layout_weight so they split evenly at any width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/m_stripe_height"
    android:orientation="horizontal">

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/bmw_m_blue" />

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/bmw_m_purple" />

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/bmw_m_red" />

</LinearLayout>
