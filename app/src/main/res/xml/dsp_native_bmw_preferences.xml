<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_low_lpf" android:title="Low LPF frequency" app:minValue="80" app:maxValue="200" app:seekBarIncrement="1" app:precision="0" app:unit="Hz" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
<ListPreference android:key="bmw_low_topology" android:title="Low topology" android:entries="@array/bmw_low_topology_entries" android:entryValues="@array/bmw_two_choice_values" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false"/>
<SwitchPreferenceCompat android:key="bmw_mute_mid" android:title="Mute mid band" app:iconSpaceReserved="false"/>
<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_mid_hpf" android:title="Mid HPF frequency" app:minValue="80" app:maxValue="200" app:seekBarIncrement="1" app:precision="0" app:unit="Hz" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
