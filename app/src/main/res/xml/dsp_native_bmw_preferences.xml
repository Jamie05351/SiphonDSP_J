<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_mid_delay_r" android:title="Mid delay R" app:minValue="0" app:maxValue="2.8" app:seekBarIncrement="0.01" app:precision="2" app:unit="ms" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_low_delay_l" android:title="Low delay L" app:minValue="0" app:maxValue="2.8" app:seekBarIncrement="0.01" app:precision="2" app:unit="ms" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_low_delay_r" android:title="Low delay R" app:minValue="0" app:maxValue="2.8" app:seekBarIncrement="0.01" app:precision="2" app:unit="ms" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
</PreferenceCategory>
<PreferenceCategory android:title="Post-sum tonality tilt">
<SwitchPreferenceCompat android:key="bmw_tilt_enable" android:title="Tilt active" app:iconSpaceReserved="false"/>
<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_tilt_amount" android:title="Tilt amount" app:minValue="-6" app:maxValue="6" app:seekBarIncrement="0.1" app:precision="1" app:unit="dB" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_tilt_pivot" android:title="Tilt pivot" app:minValue="200" app:maxValue="2000" app:seekBarIncrement="1" app:precision="0" app:unit="Hz" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
</PreferenceCategory>
<PreferenceCategory android:title="Low-band compressor">
<SwitchPreferenceCompat android:key="bmw_comp_enable" android:title="Compressor active" app:iconSpaceReserved="false"/>
<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_comp_threshold" android:title="Threshold" app:minValue="-18" app:maxValue="0" app:seekBarIncrement="1" app:precision="0" app:unit="dB" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_comp_ratio" android:title="Ratio" app:minValue="1" app:maxValue="10" app:seekBarIncrement="0.1" app:precision="1" app:unit=":1" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
