<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_mid_gain_r" android:title="Mid gain R" app:minValue="-6" app:maxValue="0" app:seekBarIncrement="0.1" app:precision="1" app:unit="dB" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_post_gain_l" android:title="Post gain L" app:minValue="-6" app:maxValue="6" app:seekBarIncrement="0.1" app:precision="1" app:unit="dB" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
