<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
<PreferenceCategory android:title="Measurements / routing" app:iconSpaceReserved="false">
<SwitchPreferenceCompat android:key="bmw_lpf_passthrough" android:title="LPF passthrough" app:iconSpaceReserved="false"/>
<SwitchPreferenceCompat android:key="bmw_hpf_passthrough" android:title="HPF passthrough" app:iconSpaceReserved="false"/>
<ListPreference android:key="bmw_channel_isolation" android:title="Channel isolation" android:entries="@array/bmw_channel_isolation_entries" android:entryValues="@array/bmw_three_choice_values" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false"/>
<ListPreference android:key="bmw_measurement_mute" android:title="Measurement mute" android:entries="@array/bmw_measurement_mute_entries" android:entryValues="@array/bmw_three_choice_values" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false"/>
</PreferenceCategory>
<PreferenceCategory android:title="Output routing" app:iconSpaceReserved="false">
<SeekBarPreference android:key="route_low_left_fl" android:title="Low Left · Front Left" android:min="-200" android:max="200" android:defaultValue="100" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
<SeekBarPreference android:key="route_low_left_fr" android:title="Low Left · Front Right" android:min="-200" android:max="200" android:defaultValue="0" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
<SeekBarPreference android:key="route_low_right_fl" android:title="Low Right · Front Left" android:min="-200" android:max="200" android:defaultValue="0" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
<SeekBarPreference android:key="route_low_right_fr" android:title="Low Right · Front Right" android:min="-200" android:max="200" android:defaultValue="100" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
<SeekBarPreference android:key="route_mid_left_fl" android:title="Mid Left · Front Left" android:min="-200" android:max="200" android:defaultValue="100" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
<SeekBarPreference android:key="route_mid_left_fr" android:title="Mid Left · Front Right" android:min="-200" android:max="200" android:defaultValue="0" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
<SeekBarPreference android:key="route_mid_right_fl" android:title="Mid Right · Front Left" android:min="-200" android:max="200" android:defaultValue="0" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
<SeekBarPreference android:key="route_mid_right_fr" android:title="Mid Right · Front Right" android:min="-200" android:max="200" android:defaultValue="100" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
<Preference android:key="route_reset_stereo" android:title="Reset to stereo defaults" android:summary="Unity same-side routing; cross-channel contributions zero" app:iconSpaceReserved="false"/>
</PreferenceCategory>
<PreferenceCategory android:title="Output all-pass" app:iconSpaceReserved="false">
<ListPreference android:key="allpass_output" android:title="Output channel" android:entries="@array/bmw_output_channel_entries" android:entryValues="@array/bmw_output_channel_values" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false"/>
<SwitchPreferenceCompat android:key="allpass_1_enabled" android:title="Section 1" app:iconSpaceReserved="false"/>
<ListPreference android:key="allpass_1_order" android:title="Section 1 type" android:entries="@array/bmw_allpass_type_entries" android:entryValues="@array/bmw_allpass_type_values" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false"/>
<SeekBarPreference android:key="allpass_1_frequency" android:title="Section 1 frequency (Hz)" android:min="20" android:max="20000" android:defaultValue="150" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
<SeekBarPreference android:key="allpass_1_q" android:title="Section 1 Q × 100" android:min="10" android:max="3000" android:defaultValue="71" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
<SwitchPreferenceCompat android:key="allpass_2_enabled" android:title="Section 2" app:iconSpaceReserved="false"/>
<ListPreference android:key="allpass_2_order" android:title="Section 2 type" android:entries="@array/bmw_allpass_type_entries" android:entryValues="@array/bmw_allpass_type_values" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false"/>
<SeekBarPreference android:key="allpass_2_frequency" android:title="Section 2 frequency (Hz)" android:min="20" android:max="20000" android:defaultValue="150" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
<SeekBarPreference android:key="allpass_2_q" android:title="Section 2 Q × 100" android:min="10" android:max="3000" android:defaultValue="71" app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
</PreferenceCategory>
</PreferenceScreen>
