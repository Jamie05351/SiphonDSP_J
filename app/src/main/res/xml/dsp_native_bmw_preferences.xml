<PreferenceCategory android:title="Subsonic / crossovers">
<SwitchPreferenceCompat android:key="bmw_subsonic_enable" android:title="Subsonic BW4" app:iconSpaceReserved="false"/>
<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_subsonic_freq" android:title="Subsonic frequency" app:minValue="20" app:maxValue="60" app:seekBarIncrement="1" app:precision="0" app:unit="Hz" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
