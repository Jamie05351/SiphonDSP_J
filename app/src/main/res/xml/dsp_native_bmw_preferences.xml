<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_low_gain_l" android:title="Low gain L" app:minValue="-6" app:maxValue="0" app:seekBarIncrement="0.1" app:precision="1" app:unit="dB" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
