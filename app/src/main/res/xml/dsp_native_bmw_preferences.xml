<app.siphondsp.preference.MaterialSeekbarPreference android:key="bmw_comp_makeup" android:title="Makeup gain" app:minValue="0" app:maxValue="6" app:seekBarIncrement="0.1" app:precision="1" app:unit="dB" app:showSeekBarValue="true" app:updatesContinuously="true" app:iconSpaceReserved="false"/>
</PreferenceCategory>
</app.siphondsp.preference.SwitchPreferenceGroup>
</PreferenceScreen>
