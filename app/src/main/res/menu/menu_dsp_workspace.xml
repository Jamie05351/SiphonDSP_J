    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/workspace_power"
        android:title="@string/workspace_power"
        android:icon="@drawable/ic_twotone_power_settings_24dp"
        app:showAsAction="always" />
</menu>
