<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="divider_default">@color/md_black_1000_12</color>

    <!-- BMW ///M Motorsport stripe colors (fixed brand colors, independent of the selected
         app palette; see view_m_stripe_divider.xml). -->
    <color name="bmw_m_blue">#008AC9</color>
    <color name="bmw_m_purple">#2B115A</color>
    <color name="bmw_m_red">#F11A22</color>

    <!-- BMW DSP workspace accent + slider value box, matching BmwDashboardSkin.LIGHT_BLUE and
         the LOW PASS/HIGH PASS crossover cards' dark background (see CrossoverDashboardBuilder,
         Widget.SiphonDSP.SliderValueBox in themes.xml). -->
    <color name="bmw_dsp_accent_blue">#46B5E8</color>
    <color name="bmw_dsp_value_box_background">#101318</color>
    <!-- Elevated panel surface for the bespoke PEQ glass value/choice dialogs (see
         ThemeOverlay.SiphonDSP.GlassDialog): a touch lighter than the near-black value box so
         the dialog reads as a raised sheet, and the grey inner input field
         (bmw_glass_dialog_field) sits one step above that again. -->
    <color name="bmw_glass_dialog_surface">#1B1B21</color>
    <color name="bmw_glass_dialog_field">#33333C</color>
    <!-- 40%-alpha panel fill for alert dialogs on the DSP workspaces (see
         AppTheme.AlertDialogTheme.Workspace); base RGB is siphon_surface (#141418). -->
    <color name="bmw_workspace_dialog_surface">#66141418</color>
    <!-- Sampled from dsp_workspace_backdrop_*.png's content-pane fill (all 5 average to within a
         couple of RGB values of each other, ~rgb(32,32,32)), so the toolbar above the tri-colour
         stripe reads as the same material as the workspace backdrop below it instead of a
         different flat tone (was ?attr/colorSurface / siphon_surface, #141418, distinctly
         darker/bluer). See the toolbar in activity_parametric_eq.xml. -->
    <color name="dsp_workspace_header_bg">#202020</color>

    <!-- AMOLED Mode -->
    <color name="surface_amoled">#000001</color>
    <color name="background_amoled">#000000</color>

    <!-- Material Design Colors -->
    <color name="md_black_1000_12">#1F000000</color>
    <color name="md_white_1000_12">#1FFFFFFF</color>

    <!-- Editor -->
    <color name="gold">#e6b121</color>

    <!--Monokai Pro Theme Colors-->
    <color name="monokia_pro_green">#9ccc6b</color>
    <color name="monokia_pro_black">#2d2a2e</color>
    <color name="monokia_pro_gray">#323033</color>
    <color name="monokia_pro_white">#fcfcfa</color>
    <color name="monokia_pro_white_dim">#BEBEBE</color>
    <color name="monokia_pro_sky_dim">#D1EEF1</color>
    <color name="monokia_pro_sky">#78dce8</color>
    <color name="monokia_pro_pink">#ff6188</color>
    <color name="monokia_pro_orange">#ffd866</color>
    <color name="monokia_pro_purple">#ab9df2</color>
    <color name="monokia_pro_grey">#727072</color>
    <color name="monokia_pro_error">#A30000</color>

</resources>