<resources>
    <dimen name="corner_radius">12dp</dimen>
    <dimen name="liveprog_group_spacing">12dp</dimen>
    <!-- A normal preference-row-sized break so adjacent BMW DSP cards read as fully separate. -->
    <dimen name="bmw_dsp_section_spacing">48dp</dimen>
    <!-- Deliberately short (vs. the standard 56dp actionBarSize) to free vertical space on
         small/landscape head-unit displays. Applies only to top header toolbars, not the bottom
         app bar. Paired with TextAppearance.SiphonDSP.ToolbarTitle (~15sp) so the centred title
         fits; at 28dp with the default ~22sp title the text clipped top and bottom.
         Shared by Settings/Blocklist/App Compatibility/Measurement Capture/the DSP main hub, none
         of which were part of the PEQ bezel-clearance testing below: see
         dsp_workspace_toolbar_height for the PEQ-specific value instead of widening this one. -->
    <dimen name="header_toolbar_height">36dp</dimen>
    <!-- PEQ workspace only (activity_parametric_eq.xml). 36dp of that is the toolbar's actual
         content band, same as header_toolbar_height above; the remaining 25dp is top padding
         (see the toolbar/DspStatusStrip/peq_toolbar_actions in that file, all three padded
         identically) keeping content clear of the head unit's physical bezel, which was cropping
         into the flush-top original. Kept separate from header_toolbar_height so that fix doesn't
         also shift Settings/Blocklist/App Compatibility/Measurement Capture/the DSP main hub,
         none of which this was tested against. -->
    <dimen name="dsp_workspace_toolbar_height">61dp</dimen>
    <!-- BMW ///M stripe divider under the top banner; see view_m_stripe_divider.xml. -->
    <dimen name="m_stripe_height">3dp</dimen>
    <!-- Width of the rail baked into the full-screen DSP workspace backdrop
         (dsp_workspace_backdrop_*.png). dsp_sidebar reserves exactly this so DspCrossNavBar's
         invisible click-targets land on the baked tiles. Measured off the current 1280x480 art.
         Kept separate from dsp_toolbar_nav_inset below: this one must stay exactly the rail's
         own width, or the backdrop art and the click-target overlay drift apart. -->
    <dimen name="dsp_sidebar_width">140dp</dimen>
    <!-- Where the toolbar's back arrow starts: the rail width plus a real buffer, not flush
         against it. A Toolbar's navigation icon touch target is a Material minimum (48dp)
         centred on the drawn 24dp glyph, not just the glyph's own bounds: flush against
         dsp_sidebar_width put that touch target right up against the rail's own click-targets.
         148dp (rail + 24dp) still read as not isolated enough on-device; +35dp gives the arrow
         real breathing room on the rail side too. -->
    <dimen name="dsp_toolbar_nav_inset">183dp</dimen>
    <!-- Bypass-state strip / dsp_toolbar_actions start here: past the back arrow's touch target
         (dsp_toolbar_nav_inset + its ~48dp target), with its own buffer for the same reason.
         Shifted the same +35dp as dsp_toolbar_nav_inset above, so the gap after the arrow's
         touch target stays the same width it was before this widening. -->
    <dimen name="dsp_status_strip_margin_start">255dp</dimen>
    <!-- DspPagerArrows sit on the toolbar's right side but inset this far from the true screen
         edge, not flush against it: the head unit's screen is sunk into the dash and boxed in by
         trim, so the extreme edge is physically hard to reach while driving. 50dp is a real
         measurement from the trim, not a guess. Real-device tuning candidate if it turns out
         wrong, same as every other value on this line. -->
    <dimen name="dsp_pager_arrows_margin_end">50dp</dimen>
</resources>
