<resources>
    <dimen name="corner_radius">12dp</dimen>
    <dimen name="liveprog_group_spacing">12dp</dimen>
    <!-- A normal preference-row-sized break so adjacent BMW DSP cards read as fully separate. -->
    <dimen name="bmw_dsp_section_spacing">48dp</dimen>
    <!-- Deliberately short (vs. the standard 56dp actionBarSize) to free vertical space on
         small/landscape head-unit displays. Applies only to top header toolbars, not the bottom
         app bar. Paired with TextAppearance.SiphonDSP.ToolbarTitle (~15sp) so the centred title
         fits; at 28dp with the default ~22sp title the text clipped top and bottom.
         36dp of that is the toolbar's actual content band; the remaining 25dp is top padding
         (see activity_parametric_eq.xml's toolbar/DspStatusStrip/peq_toolbar_actions, all three
         padded identically) keeping content clear of the head unit's physical bezel, which was
         cropping into the flush-top original. -->
    <dimen name="header_toolbar_height">61dp</dimen>
    <!-- BMW ///M stripe divider under the top banner; see view_m_stripe_divider.xml. -->
    <dimen name="m_stripe_height">3dp</dimen>
    <!-- Width of the rail baked into the full-screen DSP workspace backdrop
         (dsp_workspace_backdrop_*.png). dsp_sidebar reserves exactly this so DspCrossNavBar's
         invisible click-targets land on the baked tiles. Measured off the 1280x480 art (~124px).
         Kept separate from dsp_toolbar_nav_inset below -- this one must stay exactly the rail's
         own width, or the backdrop art and the click-target overlay drift apart. -->
    <dimen name="dsp_sidebar_width">124dp</dimen>
    <!-- Where the toolbar's back arrow starts: the rail width plus a real buffer, not flush
         against it. A Toolbar's navigation icon touch target is a Material minimum (48dp)
         centred on the drawn 24dp glyph, not just the glyph's own bounds -- flush against
         dsp_sidebar_width put that touch target right up against the rail's own click-targets. -->
    <dimen name="dsp_toolbar_nav_inset">148dp</dimen>
    <!-- Bypass-state strip / peq_toolbar_actions start here: past the back arrow's touch target
         (dsp_toolbar_nav_inset + its ~48dp target), with its own buffer for the same reason. -->
    <dimen name="dsp_status_strip_margin_start">220dp</dimen>
</resources>