<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.SiphonDSP.DspSlider" parent="Widget.Material3.Slider">
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
        <item name="trackHeight">10dp</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorSurfaceVariant</item>
        <item name="thumbColor">?attr/colorSurfaceContainerHigh</item>
        <item name="thumbStrokeColor">?attr/colorPrimary</item>
        <item name="thumbStrokeWidth">2dp</item>
        <item name="thumbWidth">14dp</item>
        <item name="thumbHeight">30dp</item>
        <item name="thumbRadius">3dp</item>
        <item name="thumbTrackGapSize">2dp</item>
        <item name="trackInsideCornerSize">3dp</item>
        <item name="haloRadius">22dp</item>
    </style>

    <style name="Widget.SiphonDSP.SegmentedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="backgroundTint">@color/selector_segmented_button_background</item>
        <item name="android:textColor">@color/selector_segmented_button_text</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
    </style>
</resources>
