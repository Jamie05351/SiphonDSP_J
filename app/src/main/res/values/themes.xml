    <style name="Theme.Transparent" parent="Theme.AppCompat">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.SiphonDSP" parent="Base.Theme.SiphonDSP" />

    <style name="ThemeOverlay.SiphonDSP.Amoled" parent="" />

    <!-- Pin every surface role the dialog and its children resolve against to the app's dark
         Carbon tokens. Without this, an AlertDialog inflated from some activity/inflater contexts
         falls back to the bare Material3 *light* palette for e.g. a filled TextInputLayout box,
         which rendered as a near-white field on a dark dialog (visible in the PEQ "Gain" /
         "Edit as string" dialogs). -->
    <style name="AppTheme.AlertDialogTheme" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">28dp</item>
        <item name="colorBackgroundFloating">@color/siphon_surface</item>
        <item name="android:colorBackground">@color/siphon_background</item>
        <item name="colorSurface">@color/siphon_surface</item>
        <item name="colorOnSurface">@color/siphon_onSurface</item>
        <item name="colorSurfaceVariant">@color/siphon_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/siphon_onSurfaceVariant</item>
        <item name="colorSurfaceContainerLow">@color/siphon_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/siphon_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/siphon_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/siphon_surfaceContainerHigh</item>
        <item name="colorOutline">@color/siphon_outline</item>
        <item name="colorOutlineVariant">@color/siphon_outlineVariant</item>
    </style>

    <!-- Bespoke compact "glass" look for the Parametric EQ per-cell value/choice dialogs:
         tighter than the stock MaterialAlertDialog (narrower window, 16dp padding, 20dp
         corners) and always the dark gunmetal surface, to match BmwDashboardSkin's workspace
         chrome rather than the default flat dialog palette. -->
    <style name="ThemeOverlay.SiphonDSP.GlassDialog" parent="@style/AppTheme.AlertDialogTheme">
        <item name="dialogCornerRadius">20dp</item>
        <item name="dialogPreferredPadding">16dp</item>
        <item name="colorSurface">@color/bmw_glass_dialog_surface</item>
        <item name="colorBackgroundFloating">@color/bmw_glass_dialog_surface</item>
        <item name="android:windowMinWidthMajor">46%</item>
        <item name="android:windowMinWidthMinor">72%</item>
    </style>

    <!-- Alert-dialog overlay passed explicitly to the value-entry dialogs on the BMW DSP
         workspaces (Gains & Delay, Crossovers & Tilt, All-pass, Compressor; see the
         dialogThemeResId arg to showInputAlert). The dialog panel becomes a 40%-alpha dark
         window so the workspace shows through, matching the 40% glass value/title boxes on those
         pages; the scrim is dropped to 0.2 so that translucency is actually visible. Title,
         field and buttons still resolve against fully-opaque on-surface colours; only the
         panel is translucent. Not wired via alertDialogTheme because BaseActivity re-applies the
         base Theme.SiphonDSP at runtime (ThemingDelegate), which would clobber it. -->
    <style name="AppTheme.AlertDialogTheme.Workspace" parent="@style/AppTheme.AlertDialogTheme">
        <item name="android:windowBackground">@drawable/bg_workspace_dialog</item>
        <item name="colorBackgroundFloating">@color/bmw_workspace_dialog_surface</item>
        <item name="android:backgroundDimAmount">0.2</item>
    </style>

    <style name="Theme.SiphonDSP.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <!-- Slim, so the centred title fits the 36dp header_toolbar_height without vertical
             clipping (the Material3 default is ~22sp, which needs a ~56dp bar). -->
        <item name="titleTextAppearance">@style/TextAppearance.SiphonDSP.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.SiphonDSP.ToolbarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Theme.SiphonDSP.BottomAppBar" parent="Widget.Material3.BottomAppBar">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Theme.SiphonDSP.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SiphonDSP.Card</item>
    </style>

    <!-- Overlaid on top of a photographic tile background, so it needs its own contrast (shadow)
         rather than relying on the theme's on-surface color. -->
    <style name="TextAppearance.SiphonDSP.TileLabel" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:shadowColor">#B3000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <style name="Theme.SiphonDSP.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/selector_material_switch_thumb_tint</item>
        <item name="trackTint">@color/selector_material_switch_track_tint</item>
    </style>

    <!-- Uniform look for every Slider in the app: a plain solid rail (no tick dots), a solid
         accent fill, and a round ball thumb: matching the on/off toggle's own colors
         (colorPrimary for the filled/active side, the same tone switches use when checked). -->
    <style name="Widget.SiphonDSP.Slider" parent="Widget.Material3.Slider">
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
        <item name="trackHeight">4dp</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorSurfaceVariant</item>
        <item name="thumbColor">?attr/colorPrimary</item>
        <item name="thumbRadius">8dp</item>
        <item name="thumbWidth">16dp</item>
        <item name="thumbHeight">16dp</item>
        <item name="thumbTrackGapSize">2dp</item>
        <item name="trackInsideCornerSize">2dp</item>
    </style>

    <!-- DSP workspace slider value readout (Compressor's XML sliders); matches
         CrossoverDashboardBuilder.createBoxedValueText()'s Kotlin-built styling: bold accent
         blue text in a darkened, embossed rounded box. minWidth/minHeight (not fixed layout
         dimensions) so a longer reading can still grow past the spec's floor size. -->
    <style name="Widget.SiphonDSP.SliderValueBox" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bmw_dsp_accent_blue</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_slider_value_box</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">30dp</item>
    </style>

    <!-- DSP workspace slider row title (Compressor's XML sliders); same embossed box language as
         Widget.SiphonDSP.SliderValueBox above but unbordered (bg_slider_title_box, no stroke).
         No fixed width here: NativeBmwCompressorFragment measures every title in a band and
         sets them all to whichever one actually needs the most room at runtime, the same
         "size to the longest sibling" approach CrossoverDashboardBuilder's own slider rows use
         (see its pendingTitleBoxes). layout_height stays fixed since every box in a row needs to
         match regardless of its own text. -->
    <style name="Widget.SiphonDSP.SliderTitleBox" parent="">
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#E7EBEF</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:background">@drawable/bg_slider_title_box</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

