<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SiphonDSP" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Disallow "Force dark theme" -->
        <item name="android:forceDarkAllowed" tools:targetApi="Q" tools:ignore="ObsoleteSdkInt">false</item>

        <item name="android:divider">@color/divider_default</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Ripples -->
        <!--<item name="colorControlHighlight">?attr/colorSurfaceVariant</item>-->

        <item name="materialSwitchStyle">@style/Theme.SiphonDSP.MaterialSwitch</item>
        <item name="toolbarStyle">@style/Theme.SiphonDSP.Toolbar</item>
        <item name="bottomAppBarStyle">@style/Theme.SiphonDSP.BottomAppBar</item>
        <item name="alertDialogTheme">@style/AppTheme.AlertDialogTheme</item>
        <item name="materialCardViewStyle">@style/Theme.SiphonDSP.CardView</item>
        <item name="cardCornerRadius">@dimen/corner_radius</item>
        <item name="sliderStyle">@style/Widget.SiphonDSP.Slider</item>

        <!-- "Carbon" palette: the app's default look (see colors_siphon.xml). -->
        <item name="colorPrimary">@color/siphon_primary</item>
        <item name="colorOnPrimary">@color/siphon_onPrimary</item>
        <item name="colorPrimaryContainer">@color/siphon_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/siphon_onPrimaryContainer</item>
        <item name="colorSecondary">@color/siphon_secondary</item>
        <item name="colorOnSecondary">@color/siphon_onSecondary</item>
        <item name="colorSecondaryContainer">@color/siphon_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/siphon_onSecondaryContainer</item>
        <item name="colorTertiary">@color/siphon_tertiary</item>
        <item name="colorOnTertiary">@color/siphon_onTertiary</item>
        <item name="colorTertiaryContainer">@color/siphon_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/siphon_onTertiaryContainer</item>
        <item name="colorError">@color/siphon_error</item>
        <item name="colorErrorContainer">@color/siphon_errorContainer</item>
        <item name="colorOnError">@color/siphon_onError</item>
        <item name="colorOnErrorContainer">@color/siphon_onErrorContainer</item>
        <item name="android:colorBackground">@color/siphon_background</item>
        <item name="colorOnBackground">@color/siphon_onBackground</item>
        <item name="colorSurface">@color/siphon_surface</item>
        <item name="colorOnSurface">@color/siphon_onSurface</item>
        <item name="colorSurfaceVariant">@color/siphon_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/siphon_onSurfaceVariant</item>
        <item name="colorSurfaceContainerLow">@color/siphon_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/siphon_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/siphon_surfaceContainerHigh</item>
        <item name="colorOutline">@color/siphon_outline</item>
        <item name="colorOutlineVariant">@color/siphon_outlineVariant</item>
        <item name="colorOnSurfaceInverse">@color/siphon_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/siphon_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/siphon_primaryInverse</item>
        <item name="android:windowBackground">@color/siphon_background</item>
    </style>

    <style name="Theme.Transparent" parent="Theme.AppCompat">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Base.Theme.SiphonDSP.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <!-- Disallow "Force dark theme" -->
        <item name="android:forceDarkAllowed" tools:targetApi="Q" tools:ignore="ObsoleteSdkInt">false</item>

        <item name="android:divider">@color/divider_default</item>

        <item name="windowActionBar">false</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="windowNoTitle">true</item>

        <item name="materialSwitchStyle">@style/Theme.SiphonDSP.MaterialSwitch</item>
        <item name="toolbarStyle">@style/Theme.SiphonDSP.Toolbar</item>
        <item name="bottomAppBarStyle">@style/Theme.SiphonDSP.BottomAppBar</item>
        <item name="alertDialogTheme">@style/AppTheme.AlertDialogTheme</item>
        <item name="cardCornerRadius">@dimen/corner_radius</item>
    </style>


    <style name="Theme.SiphonDSP" parent="Base.Theme.SiphonDSP" />
    <style name="Theme.SiphonDSP.Dialog" parent="Base.Theme.SiphonDSP.Dialog" />

    <style name="ThemeOverlay.SiphonDSP.Amoled" parent="" />

    <style name="AppTheme.AlertDialogTheme" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">28dp</item>
        <item name="colorBackgroundFloating">?attr/colorSurface</item>
    </style>

    <style name="Theme.SiphonDSP.SearchButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:minWidth" tools:ignore="PrivateResource">@dimen/mtrl_min_touch_target_size</item>
        <item name="android:minHeight" tools:ignore="PrivateResource">@dimen/mtrl_min_touch_target_size</item>
        <item name="android:background">?attr/actionBarItemBackground</item>
    </style>

    <style name="Theme.SiphonDSP.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Theme.SiphonDSP.BottomAppBar" parent="Widget.Material3.BottomAppBar">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Theme.SiphonDSP.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SiphonDSP.Card</item>
    </style>

    <style name="Theme.SiphonDSP.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/selector_material_switch_thumb_tint</item>
        <item name="trackTint">@color/selector_material_switch_track_tint</item>
    </style>

    <!-- Uniform look for every Slider in the app: a plain solid rail (no tick dots), a solid
         accent fill, and a round ball thumb: matching the on/off toggle's own colors
         (colorPrimary for the filled/active side, the same tone switches use when checked). -->
    <style name="Widget.SiphonDSP.Slider" parent="Widget.Material3.Slider">
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
        <item name="trackHeight">4dp</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorSurfaceVariant</item>
        <item name="thumbColor">?attr/colorPrimary</item>
        <item name="thumbRadius">8dp</item>
        <item name="thumbWidth">16dp</item>
        <item name="thumbHeight">16dp</item>
        <item name="thumbTrackGapSize">2dp</item>
        <item name="trackInsideCornerSize">2dp</item>
    </style>

